# Supabase (Project settings → API keys). Without them, `next dev` stores
# invitations in .data/invites.json and accounts are off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older "anon" key; only used if the publishable key above is empty.
SUPABASE_ANON_KEY=
# Secret, server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE=

# Comma-separated emails that may open /admin (after signing in with a code).
ADMIN_EMAILS=

# Optional: where the shared DWM analytics and app launcher are served from.
# NEXT_PUBLIC_DWM_ORIGIN=https://www.dealwithmuhammad.com

# Optional: let a local production build (`next start`) use the file store.
# DWM_INVITE_FILE_STORE=1
