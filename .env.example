# Upstash Redis (shared DWM store). Connect the Upstash integration on the Vercel
# project with prefix KV and these are set for you. Without them, `next dev`
# stores invitations in .data/invites.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: where the shared DWM analytics and app launcher are served from.
# NEXT_PUBLIC_DWM_ORIGIN=https://www.dealwithmuhammad.com

# Optional: let a local production build (`next start`) use the file store.
# DWM_INVITE_FILE_STORE=1
